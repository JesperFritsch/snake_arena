# .env.dev — local dev environment. Committed: no real secrets here.
#
# Loaded by scripts/dev_start.sh for both docker compose (variable
# substitution) and the API running on the host. Values are from the host's
# point of view (localhost); docker-compose.yml / docker-compose.dev.yml
# override the container-side hostnames for the services running in Docker.
#
# Put real secrets or personal overrides in .env.dev.local (gitignored);
# it is loaded after this file and wins.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=gridsnake
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_DB=gridsnake
DATABASE_URL=postgresql://gridsnake:dev_password_change_me@localhost:5432/gridsnake
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API (host, auto-reload) ─────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=1
CORS_ORIGINS=http://localhost:5173
TEMPLATES_DIR=code_templates
SANDBOX_IMAGES_DIR=sandbox-images
LOG_LEVEL=INFO

# ── Clerk (dev instance) ────────────────────────────────────────────────────
CLERK_ISSUER=https://brave-urchin-66.clerk.accounts.dev
# Only checked when a webhook arrives, and Clerk can't reach localhost anyway.
# Set the real one in .env.dev.local if you tunnel webhooks in.
CLERK_WEBHOOK_SECRET=whsec_dev_dummy
# CLERK_AUDIENCE=

# ── Bundles: local file-server (docker-compose.dev.yml) ─────────────────────
BUNDLER_BACKEND=http
BUNDLE_UPLOAD_URL=http://localhost:8081/upload
BUNDLE_READ_URL=http://localhost:8081
REPLAY_HOST=http://localhost:8081

# ── Prod only ───────────────────────────────────────────────────────────────
# Referenced by docker-compose.yml; empty here so compose doesn't warn.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
CLOUDFLARE_TUNNEL_TOKEN=
